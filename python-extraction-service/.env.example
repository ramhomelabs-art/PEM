PORT=5002
FLASK_ENV=development
FLASK_DEBUG=True

# Tesseract OCR path (update based on installation, e.g. C:\Program Files\Tesseract-OCR\tesseract.exe or /usr/bin/tesseract)
TESSERACT_CMD=tesseract

# Temporary file storage
UPLOAD_FOLDER=temp_uploads
MAX_FILE_SIZE=52428800

# Confidence thresholds
MIN_CONFIDENCE=0.6
HIGH_CONFIDENCE=0.9
