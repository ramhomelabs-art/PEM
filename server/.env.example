# ==========================================
# Server Configuration
# ==========================================
PORT=5005
NODE_ENV=development
SERVER_URL=http://localhost:5005
CLIENT_URL=http://localhost:5173

# ==========================================
# Security & JWT
# ==========================================
JWT_SECRET=your_super_secure_random_jwt_secret_min_32_characters
# Absolute session lifetime (the token's hard expiry).
JWT_EXPIRES_IN=24h
# Idle timeout: reject a session after this many minutes with no API activity.
SESSION_IDLE_MINUTES=15
ENCRYPTION_KEY=your_32_byte_aes_hex_or_base64_encryption_key
# Shared secret used to encrypt the QR device-pairing payload.
# MUST match the Android client's build-time PEM_PAIRING_SECRET.
PEM_QR_PAIRING_SECRET=your_shared_qr_pairing_secret_min_32_characters

# ==========================================
# Database Configuration (PostgreSQL / MySQL / SQLite)
# ==========================================
DB_DIALECT=postgres
DB_HOST=127.0.0.1
DB_PORT=5432
DB_USER=postgres
DB_PASS=your_db_password
DB_NAME=expense_manager

# Optional Read Replica
DB_REPLICA_HOST=127.0.0.1
DB_REPLICA_USER=postgres
DB_REPLICA_PASS=your_db_password

# ==========================================
# Microservices Integration
# ==========================================
PYTHON_SERVICE_URL=http://127.0.0.1:5002

# ==========================================
# Outbound Email / OTP (Account Recovery)
# ==========================================
# Leave SMTP_HOST unset to run in dev mode: recovery OTPs are printed to the
# server console instead of being emailed. Set the values below for real
# delivery (e.g. Gmail app password, Brevo, SendGrid SMTP, etc.).
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM=PEM Pro <no-reply@example.com>

# ==========================================
# Pending-items Email Digest (Automation Inbox + notifications)
# ==========================================
# Emails users a summary of pending transactions and undelivered
# notifications. Sent only when there is at least one pending item and the
# user has not opted out (user.preferences.emailDigest.enabled, default true).
PENDING_DIGEST_ENABLED=true
# How often the digest runs, in minutes (default 1440 = once per day).
PENDING_DIGEST_INTERVAL_MINUTES=1440
# Run one pass shortly after boot (useful for testing). Default false to avoid
# noise across restarts; the per-user throttle prevents duplicate sends.
PENDING_DIGEST_RUN_ON_START=false

# ==========================================
# Login Security Alerts
# ==========================================
# Emails users on every successful sign-in and flags sign-ins from a device /
# browser that has not been seen before for the account. Requires SMTP.
LOGIN_ALERTS_ENABLED=true

# ==========================================
# Market Data & News APIs (Optional)
# ==========================================
NEWS_API_KEY=your_news_api_key
TWELVE_DATA_API_KEY=your_twelve_data_api_key
ALPHA_VANTAGE_API_KEY=your_alpha_vantage_api_key

# ==========================================
# Mobile Push Notifications (Firebase Admin SDK)
# ==========================================
FIREBASE_PROJECT_ID=your_firebase_project_id
FIREBASE_CLIENT_EMAIL=your_firebase_service_account_email
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
