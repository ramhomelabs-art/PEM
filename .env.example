# ==============================================================================
# PEM FINANCE & AUTOMATION - ENVIRONMENT CONFIGURATION TEMPLATE
# ==============================================================================
# Copy this file to '.env' (in the project root for Docker / Portainer deployments)
# or 'server/.env' (for local bare-metal Node.js development).

# --- Portainer / Docker Build Flags ---
DOCKER_BUILDKIT=0
COMPOSE_DOCKER_CLI_BUILD=0

# --- Database Settings (PostgreSQL) ---
# For Docker Compose: DB_HOST=postgres
# For Local Bare-Metal Dev: DB_HOST=127.0.0.1
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DIALECT=postgres
DB_NAME=expense_manager
DB_USER=postgres
DB_PASS=your_secure_db_password_here
DB_EXTERNAL_PORT=5432

# --- Application Ports ---
FRONTEND_PORT=5174
BACKEND_PORT=5005
PYTHON_PORT=5002
NODE_ENV=development

# --- Python Extraction Microservice ---
# For Docker Compose: PYTHON_SERVICE_URL=http://python-service:5002
# For Local Bare-Metal Dev: PYTHON_SERVICE_URL=http://127.0.0.1:5002
PYTHON_SERVICE_URL=http://127.0.0.1:5002

# --- Security & Authentication Secrets ---
# 64-char hex string for user session JWT signing
JWT_SECRET=your_strong_64_char_hex_jwt_secret_here
# 64-char hex pairing secret matching the Android companion app
PEM_QR_PAIRING_SECRET=your_strong_64_char_hex_pairing_secret_here
# 32-character AES encryption key for securing stored passwords and backups
ENCRYPTION_KEY=your_32_character_aes_key_here

# --- Client URL (CORS & OAuth Callback Target) ---
CLIENT_URL=http://localhost:5174

# --- Financial & Market Data APIs ---
NEWS_API_KEY=your_news_api_key_here
TWELVE_DATA_API_KEY=your_twelve_data_api_key_here
ALPHA_VANTAGE_API_KEY=your_alpha_vantage_api_key_here

# --- Google OAuth (Gmail Statement Smart Sync) ---
GOOGLE_CLIENT_ID=your_google_client_id_here.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret_here
GOOGLE_REDIRECT_URI=http://localhost:5174/credit-cards/auto-statement
